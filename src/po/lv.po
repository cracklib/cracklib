#: lib/fascist.c:527
msgid "it is based on your username"
msgstr "tā ir balstīta uz jūsu lietotājvārdu"

#: lib/fascist.c:587
msgid "it is based upon your password entry"
msgstr "tā ir balstīta uz jūsu ierakstu paroļu failā"

#: lib/fascist.c:604 lib/fascist.c:612
msgid "it is derived from your password entry"
msgstr "tā ir atvasināta no jūsu ieraksta paroļu failā"

#: lib/fascist.c:624
msgid "it is derivable from your password entry"
msgstr "to var atvasināt no jūsu ieraksta paroļu failā"

#: lib/fascist.c:636
msgid "it's derivable from your password entry"
msgstr "to var atvasināt no jūsu ieraksta paroļu failā"

#: lib/fascist.c:692
msgid "you are not registered in the password file"
msgstr "jūsu konts nav reģistrēts paroļu failā"

#: lib/fascist.c:729
msgid "it is WAY too short"
msgstr "tā ir KRIETNI par īsu"

#: lib/fascist.c:734
msgid "it is too short"
msgstr "tā ir pārāk īsa"

#: lib/fascist.c:751
msgid "it does not contain enough DIFFERENT characters"
msgstr "tajā nav pietiekami daudz ATŠĶIRĪGU rakstzīmju"

#: lib/fascist.c:765
msgid "it is all whitespace"
msgstr "tā sastāv tikai no tukšumzīmēm"

#: lib/fascist.c:784
msgid "it is too simplistic/systematic"
msgstr "tā ir pārāk vienkārša/sistemātiska"

#: lib/fascist.c:789
msgid "it looks like a National Insurance number."
msgstr ""
"tā izskatās pēc Lielbritānijas sociālās apdrošināšanas (National Insurance) "
"numura."

#: lib/fascist.c:827
msgid "it is based on a dictionary word"
msgstr "tā ir balstīta uz vārdnīcas vārdu"

#: lib/fascist.c:853
msgid "it is based on a (reversed) dictionary word"
msgstr "tā ir balstīta uz (apgrieztu) vārdnīcas vārdu"

#: lib/fascist.c:893
msgid "error loading dictionary"
msgstr "kļūda, ielādējot vārdnīcu"
